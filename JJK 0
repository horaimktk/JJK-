				<ProtectedString name="Source"><![CDATA[-- Studio uses disposable sessions. Published servers use leased DataStore profiles.
local DS=game:GetService("DataStoreService")
local RunService=game:GetService("RunService")
local HTTP=game:GetService("HttpService")
local P=require(script.Parent:WaitForChild("Progression"))
local store=DS:GetDataStore("CursedDistrict_Profiles_v1")
local owner=game.JobId..HTTP:GenerateGUID(false)
local Persistence={}
function Persistence.load(player)
    if RunService:IsStudio() then return P.new(),{enabled=false,status="Studio session — progress resets on Stop"} end
    local result
    local ok=pcall(function()
        result=store:UpdateAsync("user_"..player.UserId,function(old)
            if type(old)=="table" and old.owner and old.owner~=owner and (old.expires or 0)>os.time() then return nil end
            return {data=P.sanitize(type(old)=="table" and old.data or nil),owner=owner,expires=os.time()+180}
        end)
    end)
    if not ok then return nil,{status="Your save could not load. Please rejoin; existing progress was not changed."} end
    if not result or result.owner~=owner then return nil,{status="Your profile is still open in another server. Wait a moment, then rejoin."} end
    return P.sanitize(result.data),{enabled=true,status="Progress saves automatically",expires=result.expires}
end
function Persistence.save(player,s,meta,release)
    if not meta.enabled then return true end
    if meta.saving then return false end
    meta.saving=true
    local snapshot=P.sanitize(s)
    local wrote=false
    local result
    local ok=pcall(function()
        result=store:UpdateAsync("user_"..player.UserId,function(old)
            if type(old)~="table" or old.owner~=owner then return nil end
            wrote=true
            return {data=snapshot,owner=release and "" or owner,expires=release and 0 or os.time()+180}
        end)
    end)
    meta.saving=false
    local success=ok and wrote and result~=nil
    if success then meta.expires=result.expires;meta.status="Progress saved" else meta.status="Save retry pending — stay in this server" end
    return success
end
return Persistence
]]></ProtectedString>
