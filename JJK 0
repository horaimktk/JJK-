				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local P={}
function P.new()
    return {role="",technique=0,level=1,xp=0,yen=0,power=0,vitality=0,kills=0,bosses=0,mission=0,missionCount=0}
end
function P.needed(level) return 80+level*35 end
function P.grade(s)
    if s.level>=25 and s.bosses>=3 then return "Special Grade" end
    if s.level>=16 then return "Grade 1" end
    if s.level>=10 then return "Grade 2" end
    if s.level>=6 then return "Grade 3" end
    if s.level>=3 then return "Grade 4" end
    return "Grade 5"
end
function P.roll(config,ticket)
    local total=0
    for _,t in ipairs(config.Techniques) do
        total=total+t.weight
        if ticket<=total then return t.id end
    end
    return config.Techniques[#config.Techniques].id
end
function P.maxHealth(s) return 100+(s.level-1)*9+s.vitality*20 end
function P.maxEnergy(s) return 100+(s.level-1)*3 end
function P.damage(s) return 14+(s.level-1)*2+s.power*4 end
function P.reward(s,xp,yen,maxLevel)
    local before=s.level
    s.yen=s.yen+yen
    s.xp=s.xp+xp
    while s.level<maxLevel and s.xp>=P.needed(s.level) do
        s.xp=s.xp-P.needed(s.level); s.level=s.level+1
    end
    if s.level>=maxLevel then s.xp=0 end
    return s.level-before
end
function P.price(s,item)
    if item=="power" then return 100*(s.power+1) end
    if item=="vitality" then return 90*(s.vitality+1) end
    if item=="heal" then return 40 end
    return nil
end
function P.buy(s,item)
    local cost=P.price(s,item)
    if not cost then return false,"Unknown item." end
    if (item=="power" and s.power>=10) or (item=="vitality" and s.vitality>=10) then return false,"Upgrade is maxed." end
    if s.yen<cost then return false,"Not enough yen." end
    s.yen=s.yen-cost
    if item=="power" or item=="vitality" then s[item]=s[item]+1 end
    return true,"Purchased!"
end
function P.sanitize(raw)
    local s=P.new()
    if type(raw)~="table" then return s end
    if raw.role=="Sorcerer" or raw.role=="Cursed Spirit" then s.role=raw.role end
    local limits={technique={0,6},level={1,30},xp={0,100000},yen={0,100000000},power={0,10},vitality={0,10},kills={0,10000000},bosses={0,100000},mission={0,4},missionCount={0,4}}
    for k,b in pairs(limits) do
        local n=raw[k]
        if type(n)=="number" and n==n then s[k]=math.max(b[1],math.min(b[2],math.floor(n))) end
    end
    if s.role=="" or s.technique==0 then s.role="";s.technique=0 end
    if s.level==30 then s.xp=0 else s.xp=math.min(s.xp,P.needed(s.level)-1) end
    return s
end
return P
]]></ProtectedString>
