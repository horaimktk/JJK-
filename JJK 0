				<ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local C=require(RS:WaitForChild("Config"))
local P=require(script.Parent:WaitForChild("Progression"))
local Saves=require(script.Parent:WaitForChild("Persistence"))
local event=RS:WaitForChild("GameEvent")
local rng=Random.new()
local profiles,ready,lastRequest,loading={},{},{},{}
local enemies={}
local enemyFolder=Instance.new("Folder");enemyFolder.Name="ActiveCurses";enemyFolder.Parent=workspace
local function notify(p,msg) if p.Parent then event:FireClient(p,{kind="toast",text=msg}) end end
local function body(p)
    local ch=p.Character
    local h=ch and ch:FindFirstChildOfClass("Humanoid")
    local root=ch and ch:FindFirstChild("HumanoidRootPart")
    if not h or h.Health<=0 or not root then return nil end
    return root,h
end
local function send(p)
    local q=profiles[p]
    if not q or not ready[p] then return end
    local s=q.data
    local root,h=body(p)
    event:FireClient(p,{kind="state",data=s,grade=P.grade(s),needed=P.needed(s.level),
        maxLevel=C.MaxLevel,energy=q.energy,maxEnergy=P.maxEnergy(s),health=h and h.Health or 0,
        maxHealth=P.maxHealth(s),saving=q.meta.status,blocking=q.blocking,
        cooldowns={q=q.nextSkill or 0,r=q.nextDomain or 0},prices={power=P.price(s,"power"),vitality=P.price(s,"vitality"),heal=40}})
    local ls=p:FindFirstChild("leaderstats")
    if ls then ls.Level.Value=s.level;ls.Yen.Value=s.yen;ls.Grade.Value=P.grade(s) end
end
local function stats(p,heal)
    local q=profiles[p];local root,h=body(p)
    if q and h then
        h.MaxHealth=P.maxHealth(q.data)
        if heal then h.Health=h.MaxHealth end
        h.WalkSpeed=q.blocking and 8 or 18
